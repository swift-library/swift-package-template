{
  "repository": "swift-library/swift-package-template",
  "version_file": "VERSION",
  "version_pattern": "^([^\\n]+)\\n?$",
  "changelog": "CHANGELOG.md",
  "check_command": "Scripts/check",
  "ci": {
    "include": [
      {
        "name": "macos-15-swift-6.0",
        "runner": "macos-15",
        "xcode": "16.2",
        "command": "Scripts/check --compiler-check"
      },
      {
        "name": "macos-26-swift-6.3",
        "runner": "macos-26",
        "xcode": "26.6",
        "command": "Scripts/check --compiler-check"
      },
      {
        "name": "strict-format",
        "runner": "macos-26",
        "xcode": "26.6",
        "command": "Scripts/check --format-check"
      }
    ]
  },
  "platforms": {
    "iOS": [
      18,
      26,
      27
    ],
    "macOS": [
      15,
      26,
      27
    ]
  },
  "minimum_swift": "6.0"
}
